    {
      "name": "4. POST Create Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains created book and saves bookId variable\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\", \"Book added successfully\");",
              "    pm.expect(jsonData).to.have.property(\"book\");",
              "    pm.expect(jsonData.book).to.have.property(\"id\");",
              "    ",
              "    // Store dynamically created book ID in collection variable for subsequent requests",
              "    pm.collectionVariables.set(\"bookId\", jsonData.book.id.toString());",
              "    console.log(\"Saved collection variable bookId:\", jsonData.book.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 650,\n  \"pages\": 464\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""]
        },
        "description": "Inserts a new book record into the SQLite database and dynamically stores its ID."
      },
      "response": []
    },
    {
      "name": "5. PUT Update Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains updated book details\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\", \"Book updated successfully\");",
              "    pm.expect(jsonData).to.have.property(\"book\");",
              "    pm.expect(jsonData.book.price).to.eql(750);",
              "    pm.expect(jsonData.book.title).to.include(\"Agile Software Craftsmanship\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code: A Handbook of Agile Software Craftsmanship\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 750,\n  \"pages\": 464\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books/{{bookId}}/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "{{bookId}}", ""]
        },
        "description": "Updates details of the newly created book using the dynamic {{bookId}} collection variable."
      },
      "response": []
    },
    {
      "name": "6. GET Verify Updated Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verified updated book matches persisted values\", function () {",
              "    const jsonData = pm.response.json();",
              "    const currentBookId = pm.collectionVariables.get(\"bookId\");",
              "    pm.expect(jsonData.id).to.eql(parseInt(currentBookId));",
              "    pm.expect(jsonData.price).to.eql(750);",
              "    pm.expect(jsonData.title).to.include(\"Agile Software Craftsmanship\");",
              "});"
            ],
            "type": "text/javascript"
          }
